<!DOCTYPE html>
<html lang="pt-PT">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Transportes Mercadorias E.P.A. — Serviço de Transporte, Leça do Balio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#1a1e24;
    --paper:#edeeea;
    --paper-2:#e2e3dc;
    --orange:#e8552b;
    --steel:#35506b;
    --grey:#767b85;
    --line: rgba(26,30,36,0.14);
    --card: #f5f5f1;
    color-scheme: light;
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  :root:not([data-theme="light"]){
    @media (prefers-color-scheme: dark){
      --ink:#eceae4;
      --paper:#15171b;
      --paper-2:#1c1f24;
      --orange:#ff6b3d;
      --steel:#8fb0cc;
      --grey:#9aa0a8;
      --line: rgba(236,234,228,0.16);
      --card:#1c1e23;
    }
  }
  :root[data-theme="dark"]{
    --ink:#eceae4;
    --paper:#15171b;
    --paper-2:#1c1f24;
    --orange:#ff6b3d;
    --steel:#8fb0cc;
    --grey:#9aa0a8;
    --line: rgba(236,234,228,0.16);
    --card:#1c1e23;
  }
  html{ scroll-padding-top: env(safe-area-inset-top, 0px); scroll-behavior:smooth; }
  *{ box-sizing:border-box; }
  html,body{ height:100%; }
  body{
    margin:0;
    background-color:var(--paper);
    background-image: radial-gradient(var(--line) 1px, transparent 1px);
    background-size: 26px 26px;
    background-position: -12px -12px;
    color:var(--ink);
    font-family:"IBM Plex Sans", system-ui, sans-serif;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  section, header, footer{ background-color:var(--paper); }
  .hazard{
    height:6px;
    width:100%;
    background: repeating-linear-gradient(-45deg, var(--orange) 0 10px, var(--ink) 10px 20px);
    opacity:0.9;
  }
  ::selection{ background:var(--orange); color:#fff; }
  a{ color:inherit; }
  .wrap{
    max-width:1120px;
    margin:0 auto;
    padding:0 28px;
  }
  .mono{ font-family:"IBM Plex Mono", monospace; }
  .h-display{
    font-family:"Big Shoulders Display", sans-serif;
    font-weight:800;
    letter-spacing:0.005em;
    line-height:0.92;
    text-transform:uppercase;
  }

  /* header */
  header{
    position:sticky;
    top:0;
    top: env(safe-area-inset-top, 0px);
    z-index:50;
    background:var(--paper);
    border-bottom:1px solid var(--line);
  }
  .nav{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:18px 28px;
    gap:20px;
  }
  .brand{
    display:flex;
    align-items:center;
    gap:12px;
    font-family:"Big Shoulders Display", sans-serif;
    font-weight:700;
    font-size:20px;
    text-transform:uppercase;
    letter-spacing:0.01em;
    white-space:nowrap;
  }
  .brand-mark{
    width:34px; height:34px;
    flex:none;
  }
  .nav-links{
    display:flex;
    gap:28px;
    align-items:center;
    font-size:15px;
  }
  .nav-links a{
    text-decoration:none;
    color:var(--grey);
    border-bottom:1px solid transparent;
    padding-bottom:2px;
    transition:color .15s ease, border-color .15s ease;
  }
  .nav-links a:hover{ color:var(--ink); border-color:var(--orange); }
  .nav-phone{
    display:flex;
    align-items:center;
    gap:8px;
    text-decoration:none;
    font-family:"IBM Plex Mono", monospace;
    font-size:14px;
    color:var(--ink);
    border:1px solid var(--line);
    padding:8px 14px;
    white-space:nowrap;
  }
  .nav-phone:hover{ border-color:var(--orange); color:var(--orange); }
  .nav-phone svg{ width:14px; height:14px; }

  /* hero */
  .hero{
    padding:64px 0 40px;
    border-bottom:1px solid var(--line);
  }
  .hero-grid{
    display:grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap:56px;
    align-items:end;
  }
  .eyebrow-line{
    display:flex;
    align-items:center;
    gap:10px;
    font-family:"IBM Plex Mono", monospace;
    font-size:12.5px;
    color:var(--grey);
    margin-bottom:22px;
  }
  .eyebrow-line .dot{
    width:7px; height:7px; border-radius:50%;
    background:var(--orange);
    flex:none;
  }
  .hero h1{
    font-size:clamp(42px, 6.6vw, 84px);
    margin:0 0 22px;
  }
  .hero h1 .accent{ color:var(--orange); }
  .hero p.lede{
    font-size:18px;
    line-height:1.55;
    color:var(--grey);
    max-width:46ch;
    margin:0 0 32px;
  }
  .cta-row{ display:flex; gap:14px; flex-wrap:wrap; }
  .btn{
    display:inline-flex;
    align-items:center;
    gap:10px;
    padding:14px 22px;
    font-size:15px;
    font-weight:500;
    text-decoration:none;
    border:1px solid var(--ink);
    transition: transform .15s ease, background .15s ease, color .15s ease;
  }
  .btn:active{ transform:translateY(1px); }
  .nav-links-mobile{
    display:none;
    gap:18px;
    padding:0 28px 14px;
    font-size:14px;
    font-family:"IBM Plex Mono", monospace;
    overflow-x:auto;
  }
  .nav-links-mobile a{ color:var(--grey); text-decoration:none; white-space:nowrap; }
  .btn-solid{
    background:var(--ink);
    color:var(--paper);
  }
  .btn-solid:hover{ background:var(--orange); border-color:var(--orange); color:#fff; }
  .btn-line{
    background:transparent;
    color:var(--ink);
  }
  .btn-line:hover{ border-color:var(--orange); color:var(--orange); }

  /* route svg */
  .route-box{
    border:1px solid var(--line);
    background:var(--card);
    padding:18px 18px 22px;
  }
  .route-box .cap{
    display:flex;
    justify-content:space-between;
    font-family:"IBM Plex Mono", monospace;
    font-size:11px;
    color:var(--grey);
    letter-spacing:0.04em;
    margin-bottom:10px;
  }
  #routePath{
    stroke-dasharray: 900;
    stroke-dashoffset: 900;
    animation: draw 2.1s ease-out .3s forwards;
  }
  #routeTruck{
    offset-path: path("M18,150 C60,60 120,40 170,90 S 300,190 340,110 S 420,20 470,55");
    animation: moveTruck 2.1s ease-out .3s forwards;
    opacity:0;
  }
  @keyframes draw{ to{ stroke-dashoffset:0; } }
  @keyframes moveTruck{
    0%{ offset-distance:0%; opacity:0; }
    2%{ opacity:1; }
    100%{ offset-distance:100%; opacity:1; }
  }
  @media (prefers-reduced-motion: reduce){
    #routePath{ animation:none; stroke-dashoffset:0; }
    #routeTruck{ animation:none; opacity:1; offset-distance:100%; }
  }
  .waypoints{
    display:flex;
    justify-content:space-between;
    font-family:"IBM Plex Mono", monospace;
    font-size:11.5px;
    margin-top:8px;
    color:var(--grey);
  }
  .waypoints strong{ color:var(--ink); font-weight:500; }

  section{ padding:80px 0; border-bottom:1px solid var(--line); }
  .section-head{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    gap:24px;
    margin-bottom:44px;
    flex-wrap:wrap;
  }
  .section-head h2{
    font-family:"Big Shoulders Display", sans-serif;
    font-weight:800;
    text-transform:uppercase;
    font-size:clamp(28px, 4vw, 44px);
    margin:0;
    line-height:0.95;
  }
  .section-head .tag{
    font-family:"IBM Plex Mono", monospace;
    font-size:12px;
    color:var(--grey);
    border:1px solid var(--line);
    padding:6px 12px;
  }

  /* manifest / services */
  .manifest{ border-top:1px solid var(--line); }
  .manifest-row{
    display:grid;
    grid-template-columns: 60px 1fr 1.4fr;
    gap:24px;
    padding:26px 20px;
    margin:0 -20px;
    border-bottom:1px solid var(--line);
    align-items:baseline;
    transition: background .18s ease, padding-left .18s ease;
  }
  .manifest-row:hover{
    background:var(--card);
    padding-left:28px;
  }
  .manifest-row .num{
    font-family:"IBM Plex Mono", monospace;
    color:var(--orange);
    font-size:14px;
    transition: transform .18s ease;
  }
  .manifest-row:hover .num{ transform:translateX(2px); }
  .manifest-row h3{
    font-family:"Big Shoulders Display", sans-serif;
    font-weight:700;
    text-transform:uppercase;
    font-size:24px;
    margin:0;
    letter-spacing:0.01em;
  }
  .manifest-row p{
    margin:0;
    color:var(--grey);
    font-size:15px;
    line-height:1.6;
    max-width:52ch;
  }

  /* coverage */
  .coverage-grid{
    display:grid;
    grid-template-columns: 1fr 1fr;
    gap:56px;
    align-items:center;
  }
  .coverage-list{ list-style:none; margin:0; padding:0; }
  .coverage-list li{
    display:flex;
    align-items:center;
    gap:14px;
    padding:14px 0;
    border-bottom:1px solid var(--line);
    font-size:17px;
  }
  .coverage-list li:first-child{ padding-top:0; }
  .coverage-list .marker{
    width:9px; height:9px;
    background:var(--orange);
    flex:none;
  }
  .coverage-list .zone{
    margin-left:auto;
    font-family:"IBM Plex Mono", monospace;
    font-size:12px;
    color:var(--grey);
  }
  .map-schematic{ border:1px solid var(--line); background:var(--card); padding:14px; }
  .map-schematic svg{ width:100%; height:auto; display:block; }
  .map-note{
    font-family:"IBM Plex Mono", monospace;
    font-size:11px;
    color:var(--grey);
    margin-top:10px;
    text-align:center;
  }

  /* trust */
  .trust-grid{
    display:grid;
    grid-template-columns: repeat(3, 1fr);
    gap:1px;
    background:var(--line);
    border:1px solid var(--line);
  }
  .trust-card{
    background:var(--paper);
    padding:30px 26px;
    transition: background .18s ease;
  }
  .trust-card:hover{ background:var(--card); }
  .trust-card:hover h3::before{ opacity:1; transform:translateX(0); }
  .trust-card h3{ display:flex; align-items:center; gap:8px; }
  .trust-card h3::before{
    content:"";
    width:6px; height:6px;
    background:var(--orange);
    flex:none;
    opacity:0;
    transform:translateX(-4px);
    transition: opacity .18s ease, transform .18s ease;
  }
  .trust-card h3{
    font-family:"Big Shoulders Display", sans-serif;
    font-weight:700;
    text-transform:uppercase;
    font-size:19px;
    margin:0 0 12px;
  }
  .trust-card p{
    margin:0;
    color:var(--grey);
    font-size:14.5px;
    line-height:1.6;
  }

  /* contact */
  .contact-grid{
    display:grid;
    grid-template-columns: 1fr 1fr;
    gap:56px;
  }
  .contact-card{
    position:relative;
    border:1px solid var(--line);
    background:var(--card);
    padding:36px;
  }
  .contact-card::before{
    content:"";
    position:absolute;
    top:-1px; right:-1px;
    width:0; height:0;
    border-style:solid;
    border-width:0 26px 26px 0;
    border-color:transparent var(--paper) transparent transparent;
    box-shadow: -1px 1px 0 0 var(--line);
  }
  .contact-card .label{
    font-family:"IBM Plex Mono", monospace;
    font-size:11.5px;
    color:var(--grey);
    text-transform:none;
    margin-bottom:6px;
  }
  .contact-card .value{
    font-size:20px;
    margin:0 0 26px;
  }
  .contact-card .value a{ text-decoration:none; }
  .contact-card .value a:hover{ color:var(--orange); }
  .contact-card .value.small{ font-size:16px; color:var(--grey); }
  .contact-card hr{ border:none; border-top:1px solid var(--line); margin:26px 0; }

  .contact-side p{
    color:var(--grey);
    font-size:16px;
    line-height:1.65;
    max-width:44ch;
  }
  .rating-note{
    display:inline-flex;
    align-items:center;
    gap:10px;
    margin-top:18px;
    font-family:"IBM Plex Mono", monospace;
    font-size:12px;
    color:var(--grey);
    border:1px solid var(--line);
    padding:10px 14px;
  }

  footer{ padding:40px 0 calc(40px + env(safe-area-inset-bottom, 0px)); }
  .footer-grid{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    flex-wrap:wrap;
    gap:20px;
  }
  .footer-legal{
    font-size:13px;
    color:var(--grey);
    line-height:1.6;
  }
  .footer-legal strong{ color:var(--ink); font-weight:500; }
  .footer-mark{
    font-family:"Big Shoulders Display", sans-serif;
    font-weight:700;
    text-transform:uppercase;
    font-size:16px;
  }

  @media (max-width: 860px){
    .hero-grid{ grid-template-columns:1fr; gap:36px; }
    .coverage-grid{ grid-template-columns:1fr; }
    .contact-grid{ grid-template-columns:1fr; }
    .trust-grid{ grid-template-columns:1fr; }
    .manifest-row{ grid-template-columns: 40px 1fr; }
    .manifest-row p{ grid-column: 2 / 3; }
    .nav-links{ display:none; }
    .nav-links-mobile{ display:flex; }
  }
  .scroll-x{ overflow-x:auto; }
</style>
</head>
<body>

<header>
  <div class="nav">
    <div class="brand">
      <svg class="brand-mark" viewBox="0 0 34 34" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M2 24V9h14v15" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
        <path d="M16 15h6l6 4.2V24H16" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
        <path d="M2 24h1.6" stroke="currentColor" stroke-width="1.4"/>
        <circle cx="9" cy="25.5" r="2.3" fill="var(--paper)" stroke="currentColor" stroke-width="1.4"/>
        <circle cx="24.5" cy="25.5" r="2.3" fill="var(--paper)" stroke="currentColor" stroke-width="1.4"/>
        <path d="M6 13h6M6 17h4" stroke="var(--orange)" stroke-width="1.4"/>
      </svg>
      <span>Transportes&nbsp;Mercadorias</span>
    </div>
    <nav class="nav-links">
      <a href="#servicos">Serviços</a>
      <a href="#cobertura">Cobertura</a>
      <a href="#porque">Porquê nós</a>
    </nav>
    <a class="nav-phone" href="tel:+351220111165">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5c0 9 7 16 16 16l3-4-6-3-2 2c-3-1-5-3-6-6l2-2-3-6-4 3z"/></svg>
      22 011 1165
    </a>
  </div>
  <div class="nav-links-mobile">
    <a href="#servicos">Serviços</a>
    <a href="#cobertura">Cobertura</a>
    <a href="#porque">Porquê nós</a>
    <a href="#contacto">Contacto</a>
  </div>
</header>

<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="eyebrow-line"><span class="dot"></span>Leça do Balio · Serviço de Transporte de Mercadorias</div>
      <h1 class="h-display">A sua carga,<br>no destino <span class="accent">certo.</span></h1>
      <p class="lede">Transportes Mercadorias E.P.A. faz o transporte rodoviário de mercadorias para empresas do Grande Porto, com contacto direto e sem intermediários.</p>
      <div class="cta-row">
        <a class="btn btn-solid" href="#contacto">Pedir orçamento</a>
        <a class="btn btn-line" href="tel:+351220111165">Ligar agora — 22 011 1165</a>
      </div>
    </div>
    <div class="route-box">
      <div class="cap"><span>ROTA</span><span>LEÇA DO BALIO → GRANDE PORTO</span></div>
      <svg viewBox="0 0 490 210" width="100%" height="auto">
        <path d="M18,150 C60,60 120,40 170,90 S 300,190 340,110 S 420,20 470,55" fill="none" stroke="var(--line)" stroke-width="2"/>
        <path id="routePath" d="M18,150 C60,60 120,40 170,90 S 300,190 340,110 S 420,20 470,55" fill="none" stroke="var(--orange)" stroke-width="2.4" stroke-linecap="round"/>
        <circle cx="18" cy="150" r="5" fill="var(--ink)"/>
        <circle cx="170" cy="90" r="4" fill="var(--steel)"/>
        <circle cx="340" cy="110" r="4" fill="var(--steel)"/>
        <circle cx="470" cy="55" r="5" fill="var(--orange)"/>
        <g id="routeTruck">
          <rect x="-9" y="-6" width="18" height="12" rx="1.5" fill="var(--ink)"/>
          <circle cx="-4" cy="7" r="2.4" fill="var(--ink)"/>
          <circle cx="5" cy="7" r="2.4" fill="var(--ink)"/>
        </g>
      </svg>
      <div class="waypoints">
        <span><strong>Origem</strong><br>Leça do Balio</span>
        <span><strong>Trânsito</strong><br>Matosinhos / Porto</span>
        <span style="text-align:right"><strong>Destino</strong><br>Grande Porto</span>
      </div>
    </div>
  </div>
</section>

<div class="hazard" role="presentation"></div>

<section id="servicos">
  <div class="wrap">
    <div class="section-head">
      <h2>Serviços</h2>
      <span class="tag mono">4 linhas de serviço</span>
    </div>
    <div class="manifest">
      <div class="manifest-row">
        <span class="num">01</span>
        <h3>Mercadorias gerais</h3>
        <p>Transporte rodoviário de mercadorias diversas, embaladas ou paletizadas, para empresas e particulares.</p>
      </div>
      <div class="manifest-row">
        <span class="num">02</span>
        <h3>Distribuição local</h3>
        <p>Entregas na área de Leça do Balio, Matosinhos e concelhos vizinhos, com acompanhamento direto do transportador.</p>
      </div>
      <div class="manifest-row">
        <span class="num">03</span>
        <h3>Cargas fracionadas</h3>
        <p>Transporte de volumes de pequena e média dimensão, adequados a envios pontuais e não apenas a cargas completas.</p>
      </div>
      <div class="manifest-row">
        <span class="num">04</span>
        <h3>Serviço sob marcação</h3>
        <p>Recolhas e entregas combinadas por telefone, ajustadas à data e ao destino pretendidos pelo cliente.</p>
      </div>
    </div>
  </div>
</section>

<section id="cobertura">
  <div class="wrap coverage-grid">
    <div>
      <div class="section-head" style="margin-bottom:28px;">
        <h2>Zona&nbsp;de<br>atuação</h2>
      </div>
      <ul class="coverage-list">
        <li><span class="marker"></span>Leça do Balio <span class="zone">SEDE</span></li>
        <li><span class="marker"></span>Matosinhos <span class="zone">01</span></li>
        <li><span class="marker"></span>Porto <span class="zone">02</span></li>
        <li><span class="marker"></span>Maia <span class="zone">03</span></li>
        <li><span class="marker"></span>Grande Porto <span class="zone">04</span></li>
      </ul>
    </div>
    <div>
      <div class="map-schematic">
        <svg viewBox="0 0 320 260" width="100%" height="auto">
          <g stroke="var(--line)" stroke-width="1">
            <line x1="0" y1="65" x2="320" y2="65"/>
            <line x1="0" y1="130" x2="320" y2="130"/>
            <line x1="0" y1="195" x2="320" y2="195"/>
            <line x1="80" y1="0" x2="80" y2="260"/>
            <line x1="160" y1="0" x2="160" y2="260"/>
            <line x1="240" y1="0" x2="240" y2="260"/>
          </g>
          <g stroke="var(--grey)" stroke-width="1" opacity="0.5">
            <line x1="0" y1="8" x2="0" y2="0"/>
            <line x1="80" y1="8" x2="80" y2="0"/>
            <line x1="160" y1="8" x2="160" y2="0"/>
            <line x1="240" y1="8" x2="240" y2="0"/>
            <line x1="320" y1="8" x2="320" y2="0"/>
          </g>
          <circle cx="80" cy="130" r="6" fill="var(--orange)"/>
          <text x="80" y="150" text-anchor="middle" font-family="IBM Plex Mono" font-size="10" fill="var(--grey)">Leça do Balio</text>
          <circle cx="160" cy="90" r="4" fill="var(--steel)"/>
          <text x="160" y="78" text-anchor="middle" font-family="IBM Plex Mono" font-size="10" fill="var(--grey)">Matosinhos</text>
          <circle cx="200" cy="160" r="4" fill="var(--steel)"/>
          <text x="200" y="178" text-anchor="middle" font-family="IBM Plex Mono" font-size="10" fill="var(--grey)">Porto</text>
          <circle cx="110" cy="60" r="4" fill="var(--steel)"/>
          <text x="110" y="48" text-anchor="middle" font-family="IBM Plex Mono" font-size="10" fill="var(--grey)">Maia</text>
          <path d="M80,130 L160,90 M80,130 L200,160 M80,130 L110,60" stroke="var(--orange)" stroke-width="1" stroke-dasharray="3 3" fill="none" opacity="0.6"/>
        </svg>
      </div>
      <div class="map-note">esquema indicativo — não é um mapa à escala</div>
    </div>
  </div>
</section>

<section id="porque">
